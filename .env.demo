# ============================================================================
#  DEMO TEMPLATE: copy to ".env" on the machine that runs the backend.
#
#      copy .env.demo .env            (Windows)      cp .env.demo .env   (macOS/Linux)
#
#  Everything is filled in EXCEPT the four values marked  <<< FILL IN.
#  Never commit the real ".env": it is git-ignored on purpose. It holds secrets.
#
#  Not stored here (set them in the app, Settings screen, after the first start):
#    - the owner's WhatsApp number   - the shop name and number   - "shopkeeper agreed" tick
#
#  Before the demo (see README, "Messaging modes"):
#    1. Both phones joined to the Twilio WhatsApp sandbox (send "join <code>" to +1 415 523 8886).
#       The join lasts about 3 days, so do it again on the morning of the demo.
#    2. ngrok installed and signed in once:  ngrok config add-authtoken <token>
#    3. Start the tunnel:   ngrok http --url=<your-domain> 8000
#    4. Twilio console > Messaging > Try it out > WhatsApp sandbox settings:
#         "When a message comes in" = <PUBLIC_BASE_URL>/webhooks/twilio   (HTTP POST)
#    5. First time only:   python -m app.seed
#    6. Start the backend: uvicorn app.main:app --host 0.0.0.0 --port 8000
# ============================================================================

APP_ENV=dev
DATABASE_URL=sqlite:///./smartband.db

# --- passwords: choose your own ---------------------------------------------
DASHBOARD_PASSWORD=choose-a-dashboard-password        # <<< FILL IN
SESSION_SECRET=choose-a-long-random-string             # <<< FILL IN
DEVICE_PROVISION_SECRET=choose-a-strap-secret          # <<< FILL IN (the strap sketch must use the same value)

# --- public address: your fixed ngrok domain, exactly, with https:// ----------
PUBLIC_BASE_URL=https://flockiest-bettyann-flashily.ngrok-free.dev

# --- WhatsApp through the Twilio sandbox -------------------------------------
MESSAGING_MODE=twilio_sandbox
TWILIO_ACCOUNT_SID=                                    # <<< FILL IN (Twilio console; starts with AC)
TWILIO_AUTH_TOKEN=                                     # <<< FILL IN (Twilio console; keep it secret)
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Content Template IDs (not secret, but they belong to the Twilio account that created them).
# Owner: body "Your pantry list is ₹{{2}}: {{1}}. Send this order to your shop?"
#        buttons: "Place Order" id order:{{3}}:yes   and   "Not now" id order:{{3}}:no
# Shop:  body "New order from {{1}}: {{2}}. Total ₹{{3}}. Please confirm delivery."
#        buttons: "Confirm delivery" id shop:{{4}}:confirm   and   "Can't deliver" id shop:{{4}}:decline
# Leave a value blank to send plain text instead (typed ORDER / NO / CONFIRM / CANT replies still work).
TWILIO_CONTENT_SID_OWNER=HX0c6dac516371223378563a013d8db83f
TWILIO_CONTENT_SID_SHOP=HX3275c75577541eb38b3a198dda61b312

MQTT_ENABLED=false
MQTT_URL=
MQTT_USERNAME=
MQTT_PASSWORD=

# Demo only: a jar that stays LOW this many seconds joins the shopping list (normally 20 minutes).
DEV_HOLD_SECONDS=10
